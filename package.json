{
  "name": "nexbot",
  "private": true,
  "version": "0.3.8",
  "description": "NexBot — team of AI agents in a chat app (LuNex Inc)",
  "author": "LuNex Inc",
  "type": "module",
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "dev:server": "node server/index.ts",
    "dev:desktop": "electron .",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "build:server": "tsc -p tsconfig.server.build.json",
    "build:speech": "swiftc -O electron/resources/speech-helper.swift -o electron/resources/speech-helper",
    "package": "pnpm build && pnpm build:server && electron-builder --publish never",
    "package:win": "pnpm build && pnpm build:server && node scripts/stage-cua-driver.mjs && electron-builder --win --publish never",
    "package:mac": "pnpm build && pnpm build:server && pnpm build:speech && node scripts/stage-cua-driver.mjs && electron-builder --mac --publish never",
    "package:linux": "pnpm build && pnpm build:server && node scripts/stage-cua-driver.mjs && electron-builder --linux --publish never",
    "cua:install": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"irm https://cua.ai/driver/install.ps1 | iex\""
  },
  "dependencies": {
    "@trycua/cua-driver": "^0.19.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.539.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vite": "^7.1.0",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "@trycua/cua-driver-win32-x64-msvc": "0.19.3"
  }
}
