{
  "name": "nexbot",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.5.6",
  "description": "NexBot \u2014 team of AI agents in a chat app (LuNex Inc)",
  "author": "LuNex Inc",
  "type": "module",
  "main": "electron/main.mjs",
  "bin": {
    "nexbot": "scripts/nexbot.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "dev:server": "node server/index.ts",
    "dev:desktop": "electron .",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "lint": "eslint server src scripts vite.config.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "doctor": "node scripts/nexbot.mjs doctor",
    "benchmark": "node scripts/nexbot.mjs benchmark",
    "preview": "vite preview",
    "build:server": "tsc -p tsconfig.server.build.json",
    "build:speech": "swiftc -O electron/resources/speech-helper.swift -o electron/resources/speech-helper",
    "package": "pnpm build && pnpm build:updater && pnpm build:server && electron-builder --publish never",
    "package:win": "pnpm build && pnpm build:updater && pnpm build:server && node scripts/stage-cua-driver.mjs && electron-builder --win --publish never",
    "package:mac": "pnpm build && pnpm build:updater && pnpm build:server && pnpm build:speech && node scripts/stage-cua-driver.mjs && electron-builder --mac --publish never",
    "package:linux": "pnpm build && pnpm build:updater && pnpm build:server && node scripts/stage-cua-driver.mjs && electron-builder --linux --publish never",
    "build:updater": "node scripts/build-updater.mjs",
    "cua:install": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"irm https://cua.ai/driver/install.ps1 | iex\""
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@trycua/cua-driver": "^0.21.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.539.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.11",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.6.2",
    "esbuild": "^0.25.0",
    "eslint": "^10.9.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "@trycua/cua-driver-win32-x64-msvc": "0.21.0"
  }
}
